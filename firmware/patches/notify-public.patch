+void Application::PlayNotify(const std::string& audio_url, const std::string& text) {
+    std::vector<NotifySubtitle> subtitles;
+    if (!text.empty()) {
+        subtitles.push_back({.start_ms = 0, .text = text});
+    }
+    Schedule([this, url = audio_url, subtitles = std::move(subtitles)]() mutable {
+        StartNotification(std::move(url), std::move(subtitles));
+    });
+}
