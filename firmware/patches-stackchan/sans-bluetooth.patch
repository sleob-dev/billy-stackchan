diff --git a/firmware/main/hal/utils/bleprph/bleprph_off.c b/firmware/main/hal/utils/bleprph/bleprph_off.c
new file mode 100644
index 0000000..4fe4d3a
--- /dev/null
+++ b/firmware/main/hal/utils/bleprph/bleprph_off.c
@@ -0,0 +1,77 @@
+/*
+ * Billy : remplace le module Bluetooth quand il est coupé (CONFIG_BT_ENABLED=n), pour rendre
+ * environ 23 Ko de RAM interne. Billy se comporte comme s'il n'était jamais connecté en
+ * Bluetooth : l'appli StackChan World ne peut plus le joindre (Avatar, Dance, réglage du Wi-Fi).
+ */
+#include "sdkconfig.h"
+#if !CONFIG_BT_ENABLED
+#include "bleprph.h"
+#include "esp_log.h"
+
+void stackchan_ble_register_callbacks(const stackchan_ble_callbacks_t *callbacks)
+{
+    (void)callbacks;
+}
+
+int stackchan_ble_notify_motion(const char *json_data, uint16_t len)
+{
+    (void)json_data;
+    (void)len;
+    return -1;
+}
+
+int stackchan_ble_notify_avatar(const char *json_data, uint16_t len)
+{
+    (void)json_data;
+    (void)len;
+    return -1;
+}
+
+int stackchan_ble_notify_config(const char *json_data, uint16_t len)
+{
+    (void)json_data;
+    (void)len;
+    return -1;
+}
+
+int stackchan_ble_notify_rgb(const char *json_data, uint16_t len)
+{
+    (void)json_data;
+    (void)len;
+    return -1;
+}
+
+int stackchan_ble_update_battery_level(uint8_t level)
+{
+    (void)level;
+    return -1;
+}
+
+void stackchan_ble_set_conn_handle(uint16_t conn_handle)
+{
+    (void)conn_handle;
+}
+
+bool stackchan_ble_is_connected(void)
+{
+    return false;
+}
+
+void gatt_svr_register_cb(struct ble_gatt_register_ctxt *ctxt, void *arg)
+{
+    (void)ctxt;
+    (void)arg;
+}
+
+int gatt_svr_init(bool use_alt_uuid)
+{
+    (void)use_alt_uuid;
+    return -1;
+}
+
+void ble_prph_init(bool use_alt_uuid)
+{
+    (void)use_alt_uuid;
+    ESP_LOGW("bleprph", "Bluetooth coupé dans ce firmware (Billy) : pas de serveur BLE");
+}
+#endif  // !CONFIG_BT_ENABLED
