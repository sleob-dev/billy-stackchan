@@ -17,6 +17,29 @@ from core.utils import p3
 from pydub import AudioSegment
 from typing import Callable, Any
 
+
+# Billy : la voix Piper arrive à pleine échelle (0 dBFS) ; 4 dB de marge pour que l'ampli et le
+# petit haut-parleur du robot ne craquent pas sur les pointes (remonter le volume de Billy si besoin).
+MARGE_VOIX_DB = -4.0
+
+
+def _mono_16bits(audio: AudioSegment, sample_rate: int) -> AudioSegment:
+    """Billy : mono, 16 bits, au débit voulu, rééchantillonné par soxr (filtré), avec MARGE_VOIX_DB.
+
+    pydub.set_frame_rate (audioop.ratecv) interpole sans filtre anti-repliement : les aigus de la
+    voix Piper (22 050 Hz, davantage avec la « hauteur ») se repliaient en souffle grésillant,
+    17 dB sous la voix avec Siwis. Avec soxr, le bruit ajouté devient inaudible.
+    """
+    audio = audio.set_channels(1).set_sample_width(2)
+    pcm = np.frombuffer(audio.raw_data, dtype=np.int16).astype(np.float32)
+    if audio.frame_rate != sample_rate:
+        import soxr
+
+        pcm = soxr.resample(pcm, audio.frame_rate, sample_rate, quality="HQ")
+    pcm = np.clip(pcm * 10 ** (MARGE_VOIX_DB / 20), -32768, 32767)
+    return AudioSegment(pcm.astype(np.int16).tobytes(), frame_rate=sample_rate, sample_width=2,
+                        channels=1)
+
 TAG = __name__
 
 
