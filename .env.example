# Réglages de Billy. Copiez ce fichier en .env (ignoré par git), puis sur le serveur en
# /opt/billy/billy.env (droits 600). Les valeurs ci-dessous sont des exemples fictifs.

# --- Réseau ------------------------------------------------------------------------------
# Adresse du serveur vue par le robot (IP fixe ou nom résolu sur votre réseau local)
BILLY_SERVEUR=192.0.2.10
# Décalage horaire envoyé au robot, et fuseau pour la recherche web de Claude
BILLY_FUSEAU=+1
BILLY_FUSEAU_NOM=Europe/Paris

# --- Le robot et vous ---------------------------------------------------------------------
# Nom du robot, en minuscules (il sert aussi aux commandes « au revoir billy »)
BILLY_NOM=billy
BILLY_PRENOM=Alex
BILLY_REPONSE_REVEIL=Oui Alex ?
BILLY_SALUT=Salut Alex !

# --- LLM : ClaudeLLM, OpenAILLM ou OllamaLLM ----------------------------------------------
BILLY_LLM=ClaudeLLM

# Claude (Anthropic) : aussi utilisé pour décrire les photos de la caméra
ANTHROPIC_API_KEY=<VOTRE_CLE_API_ANTHROPIC>
BILLY_CLAUDE_MODELE=claude-haiku-5-5
# Recherches web par réponse (outil payant d'Anthropic) : 0 pour les couper
BILLY_RECHERCHE_WEB=0

# OpenAI ou service compatible (Mistral, DeepSeek, LM Studio…)
OPENAI_API_KEY=<VOTRE_CLE_API_OPENAI>
BILLY_OPENAI_URL=https://api.openai.com/v1
BILLY_OPENAI_MODELE=gpt-4o-mini

# Ollama, sur le serveur ou une autre machine du réseau
BILLY_OLLAMA_URL=http://127.0.0.1:11434
BILLY_OLLAMA_MODELE=qwen2.5

# --- Reconnaissance vocale (faster-whisper) -----------------------------------------------
# tiny, base, small… : plus gros = plus juste, mais plus lent
BILLY_WHISPER_MODELE=base

# --- Voix (Piper) -------------------------------------------------------------------------
# Nom d'une voix téléchargée dans /opt/billy/piper/voix/ ; réglages essayés dans le simulateur
BILLY_PIPER_VOIX=fr_FR-siwis-medium
BILLY_PIPER_VITESSE=1.0
BILLY_PIPER_EXPRESSIVITE=0.667
BILLY_PIPER_RYTHME=0.8
BILLY_PIPER_HAUTEUR=1.0

# --- Météo (Open-Meteo, sans clé) ---------------------------------------------------------
# Laissez LAT et LON vides pour désactiver l'outil météo
BILLY_METEO_LAT=48.8566
BILLY_METEO_LON=2.3522
BILLY_METEO_NOM=Paris
BILLY_PAYS=FR
